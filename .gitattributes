# ============================================================================
# ROBOEGG — Git Attributes
# ============================================================================

# Auto detect text files and perform LF normalization
* text=auto

# Force LF for source files
*.py text eol=lf
*.ino text eol=lf
*.c text eol=lf
*.h text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.tex text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.gz binary
